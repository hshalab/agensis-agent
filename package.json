{
  "name": "agensis-agent-monorepo",
  "version": "0.1.56",
  "private": true,
  "description": "Open-source Relay host (agensis-agent) for Agensis workspace agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspace=agensis-cli",
    "test": "AGENSIS_ACP=0 node --experimental-test-module-mocks --test tests/*.test.cjs tests/*.test.mjs",
    "test:unit": "vitest run tests/unit",
    "build": "npm run build --workspace=@agensis/agensis-agent",
    "version:check": "node scripts/check-version.mjs",
    "artifact:smoke": "node scripts/smoke-packed-artifact.mjs",
    "pack:dry-run": "npm run pack:dry-run --workspace=@agensis/agensis-agent",
    "verify": "npm run version:check && npm run check && npm test && npm run test:unit && npm run build && npm run artifact:smoke"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
